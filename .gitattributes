# Keep line endings deterministic across platforms. Without this, core.autocrlf
# on Windows makes every checkout look "modified" and pollutes diffs.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary

# Generated by the pipeline: keep the diff readable rather than one giant line.
data/algaewatch_data.json -diff
index.html -diff
